# ==============================================================================
# Comprehensive .gitignore for GSTBilling PRO (Fullstack React + Node.js + MongoDB)
# Zero Secret Leakage / Multi-Platform / All Operating Systems
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SECRETS (NEVER SHARE ANY API / CREDENTIALS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
**/.env
**/.env.*
!**/.env.example
secrets/
private/
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
# 2. APPLICATION LOGS & CHAT HISTORY (PREVENTS SENSITIVE CHAT / KEY LEAKAGE)
# ------------------------------------------------------------------------------
ai_chat_history.txt
*chat_history*.txt
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite.log

# ------------------------------------------------------------------------------
# 3. DEPENDENCY DIRECTORIES
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 4. BUILD & COMPILATION ARTIFACTS
# ------------------------------------------------------------------------------
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
**/out/
.next/
.nuxt/
.vuepress/dist
.output/

# ------------------------------------------------------------------------------
# 5. DATABASE & LOCAL STORAGE ARTIFACTS
# ------------------------------------------------------------------------------
mongo-data/
*.sqlite
*.sqlite3
*.db
.mongodb-memory-server/
.cache/

# ------------------------------------------------------------------------------
# 6. TESTING & CODE COVERAGE
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov
.clinic

# ------------------------------------------------------------------------------
# 7. OPERATING SYSTEM & ARCHIVE FILES (WINDOWS, MACOS, LINUX)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 8. IDE, EDITORS & TOOLING CACHE
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*.bak
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.fleet/
.sublime-workspace
.sublime-project
.astro/
.turbo/
.parcel-cache/
.oxlint-cache/
.eslintcache

# ------------------------------------------------------------------------------
# 9. MISCELLANEOUS TEMPORARY FILES
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
